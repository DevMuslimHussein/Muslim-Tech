{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Pin the output layout to dist/main.js. Without an explicit rootDir, tsc
    // infers the common source root — and because prisma/seed.ts sits outside
    // src/, that root becomes the package folder, emitting dist/src/main.js
    // and breaking `node dist/main` in production.
    "rootDir": "./src"
  },
  "exclude": ["node_modules", "test", "dist", "prisma", "**/*spec.ts"]
}
